# Column narrower than the 36-wide default pane: wraps at column 20,
# leaving a dead zone from 20 to the pane edge.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 20
-- text --
abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefgh
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  abcdefghijklmnopqrst                  |
|  uvwxyzabcdefghijklmn                  |
|  opqrstuvwxyzabcdefgh                  |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
