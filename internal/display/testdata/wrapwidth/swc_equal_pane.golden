# Column equal to the 36-wide pane (clamp-boundary equality): wraps at
# the pane edge exactly, no dead zone.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 36
-- text --
abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefgh
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  abcdefghijklmnopqrstuvwxyzabcdefghij  |
|  klmnopqrstuvwxyzabcdefgh              |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
