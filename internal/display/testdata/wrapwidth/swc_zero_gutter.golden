# softwrapcolumn off (0) with a real gutter (ruler on): exercises the
# wrapWidth = bufWidth default path with gutterOffset != 0. The third
# line is long enough to wrap once, showing the wrap point lands at the
# full post-gutter pane width, not some narrower column.
win 36x10@2,1
set diffgutter false
set ruler true
set scrollbar false
set softwrap true
set softwrapcolumn 0
-- text --
one
two
abcdefghijklmnopqrstuvwxyzabcdefghijklmn
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  1 one                                 |
|  2 two                                 |
|  3 abcdefghijklmnopqrstuvwxyzabcdefgh  |
|    ijklmn                              |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
