# The cursor-line highlight must span the full pane width, including the
# dead zone, on every wrapped visual row.
win 36x10@2,1
set cursorline true
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 20
style
-- text --
abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefgh
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  abcdefghijklmnopqrst                  |
|  uvwxyzabcdefghijklmn                  |
|  opqrstuvwxyzabcdefgh                  |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |

# styles
|                                        |
|  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  |
|  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  |
|  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  |
|  AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA  |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  |
|                                        |

A: fg=default bg=#0000ff attrs=0x0
B: fg=default bg=default attrs=0x4
