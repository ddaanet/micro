# A long line scrolled horizontally by startcol, with the color-column
# guide. cursorline is disabled so only the color-column highlight shows.
win 36x10@2,1
set colorcolumn 30
set cursorline false
set diffgutter false
set ruler false
set scrollbar false
set softwrap false
startcol 10
style
-- text --
abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzab
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  klmnopqrstuvwxyzabcdefghijklmnopqrst  |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |

# styles
|                                        |
|                      A                 |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB  |
|                                        |

A: fg=default bg=#ff0000 attrs=0x0
B: fg=default bg=default attrs=0x4
