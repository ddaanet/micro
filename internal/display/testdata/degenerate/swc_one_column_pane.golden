# Degenerate one-column pane (no gutter): verify no panic, one
# character per visual row.
win 1x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 0
-- text --
abc
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
