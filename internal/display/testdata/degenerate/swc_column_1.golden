# Degenerate softwrapcolumn=1: wraps at column 1 (one character per
# visual row) in the default 36-wide pane; verify no panic.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 1
-- text --
abcdefgh
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  a                                     |
|  b                                     |
|  c                                     |
|  d                                     |
|  e                                     |
|  f                                     |
|  g                                     |
|  h                                     |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
