# A tab whose natural stop would land past the wrap column clamps
# against the wrap edge (wrapMaxWidth), not the pane edge. With
# tabsize=4, a tab's next stop from any column < 20 is always <= 20 (20
# is an exact multiple of 4), so it could never cross the wrap column.
# tabsize=8 makes the tab's natural stop column 24 (18 + (8 - 18%8) =
# 24), which exceeds the wrap column 20 and forces the clamp to width 2:
# the tab consumes only columns 18-19, "bc" wraps to the next row, and
# no content bleeds into the dead zone.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 20
set tabsize 8
-- text --
abcdefghijklmnopqr	bc
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  abcdefghijklmnopqr                    |
|  bc                                    |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
