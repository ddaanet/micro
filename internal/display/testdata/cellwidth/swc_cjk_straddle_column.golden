# A double-width CJK rune landing on the wrap-column boundary wraps
# whole (moves entirely to the next visual row) rather than being
# split; the margin stays clean.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set softwrapcolumn 20
-- text --
abcdefghijklmnopqrs一二三四
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  abcdefghijklmnopqrs                   |
|  一二三四                              |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
