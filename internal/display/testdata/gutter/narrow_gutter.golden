# Twelve lines force two-digit line numbering, so the ruler wants three
# columns. The window holds more lines than its height, so LinesNum()
# exceeds Height and scrollbarWidth becomes 1 (see updateDisplayInfo).
# diffgutter(1) + ruler(3) = 4 then wants more than Width(4) -
# scrollbarWidth(1) = 3, so gutterOffset is clamped down to 3 rather than
# merely landing there naturally.
win 4x10@2,1
set diffgutter true
set ruler true
set scrollbar true
set softwrap true
-- text --
one
two
three
four
five
six
seven
eight
nine
ten
eleven
twelve
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|     |                                  |
|     |                                  |
|     |                                  |
|     |                                  |
|     |                                  |
|     |                                  |
|     |                                  |
|     |                                  |
|                                        |
|  No n                                  |
|                                        |
