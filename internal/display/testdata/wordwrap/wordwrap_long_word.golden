# A single word too long for one row hard-breaks at the pane edge.
win 36x10@2,1
set diffgutter false
set ruler false
set scrollbar false
set softwrap true
set wordwrap true
-- text --
hi abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwx
-- want --
 0000000000111111111122222222223333333333 
 0123456789012345678901234567890123456789 
|                                        |
|  hi                                    |
|  abcdefghijklmnopqrstuvwxyzabcdefghij  |
|  klmnopqrstuvwx                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|                                        |
|  No name (1,1) | ft:unknown | unix |   |
|                                        |
